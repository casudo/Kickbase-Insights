# Copy to .env and fill in your values. .env is gitignored.
#
# Nothing loads this automatically (the project has no python-dotenv), so it has
# to be sourced explicitly before running main.py or app.py:
#
#   set -a; source .env; set +a
#   ./venv/bin/python main.py
#
# main.py and app.py also have to be run from the root of the repository, since
# the data paths in backend/paths.py are derived from the working directory.

### --- Required ---

### Your Kickbase login.
KB_MAIL=your@mail.de
KB_PASSWORD=your-password

### Must be a well-formed Discord webhook URL. A dead one is fine (the resulting
### HTTP 401 is harmless), but a malformed one makes discord_notification raise,
### which main() catches by returning early - leaving no data files behind.
DISCORD_WEBHOOK=https://discord.com/api/webhooks/000000000000000000/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

### The date your season started, in dd.mm.yyyy format.
START_DATE=22.08.2025

### --- Optional ---

### The league to show data for in the GUI. Defaults to the first league you are in.
KB_LIGA=Your League Name

### 50000000 = game mode "Auslosung", 200000000 = game mode "Ohne Team".
### Any other value makes entrypoint.py exit. Defaults to 50000000.
START_MONEY=50000000

### The version string shown in the frontend.
REACT_APP_VERSION=dev

### Cron expression for how often entrypoint.py re-runs main.py (Docker only).
### Defaults to "10 2,6,10,14,18,22 * * *".
RUN_SCHEDULE=10 2,6,10,14,18,22 * * *

### Timezone (Docker only). Defaults to Europe/Berlin.
TZ=Europe/Berlin
