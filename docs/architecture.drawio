  <diagram id="flows" name="What happens when …">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="flows-0" />
        <mxCell id="flows-1" parent="flows-0" />
        <mxCell id="flows-title" value="&lt;font style=&quot;font-size: 22px&quot;&gt;&lt;b&gt;What happens when …&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;" vertex="1" parent="flows-1">
          <mxGeometry x="40" y="10" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="flows-login" value="&lt;b&gt;Logging in&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;every visitor uses their own Kickbase account&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="flows-1">
          <mxGeometry x="40" y="90" width="170" height="104" as="geometry" />
        </mxCell>
        <mxCell id="flows-login-0" value="&lt;b&gt;1 · Login form&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;e-mail and password, sent once to POST /api/auth/login&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="flows-1">
          <mxGeometry x="240" y="90" width="200" height="104" as="geometry" />
        </mxCell>
        <mxCell id="flows-login-1" value="&lt;b&gt;2 · auth/accounts.py&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;hands the password to Kickbase and keeps nothing of it&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="flows-1">
          <mxGeometry x="490" y="90" width="200" height="104" as="geometry" />
        </mxCell>
        <mxCell id="flows-login-1-e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="flows-1" source="flows-login-0" target="flows-login-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flows-login-2" value="&lt;b&gt;3 · Kickbase&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;answers with a session token and the user's leagues&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fillColor=#ffffff;strokeColor=#333333;dashed=1;strokeWidth=1.5;" vertex="1" parent="flows-1">
          <mxGeometry x="740" y="90" width="200" height="104" as="geometry" />
        </mxCell>
        <mxCell id="flows-login-2-e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="flows-1" source="flows-login-1" target="flows-login-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flows-login-3" value="&lt;b&gt;4 · auth/security.py&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;the token is stored encrypted, the browser gets a random session cookie&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="flows-1">
          <mxGeometry x="990" y="90" width="200" height="104" as="geometry" />
        </mxCell>
        <mxCell id="flows-login-3-e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="flows-1" source="flows-login-2" target="flows-login-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flows-login-4" value="&lt;b&gt;5 · sync/service.py&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;syncs the user's leagues in the background, unless they are up to date&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="flows-1">
          <mxGeometry x="1240" y="90" width="200" height="104" as="geometry" />
        </mxCell>
        <mxCell id="flows-login-4-e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="flows-1" source="flows-login-3" target="flows-login-4">
          <mxGeometry relative="1" as="geometry" />
