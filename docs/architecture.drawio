        <mxCell id="flows-page" value="&lt;b&gt;Opening a page&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;e.g. the Transfermarkt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="flows-1">
          <mxGeometry x="40" y="290" width="170" height="104" as="geometry" />
        </mxCell>
        <mxCell id="flows-page-0" value="&lt;b&gt;1 · Browser&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;TanStack Query asks for GET /api/market?league=…&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="flows-1">
          <mxGeometry x="240" y="290" width="200" height="104" as="geometry" />
        </mxCell>
        <mxCell id="flows-page-1" value="&lt;b&gt;2 · api/routes.py&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;who is it (session cookie)? a member of that league?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="flows-1">
          <mxGeometry x="490" y="290" width="200" height="104" as="geometry" />
        </mxCell>
        <mxCell id="flows-page-1-e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="flows-1" source="flows-page-0" target="flows-page-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flows-page-2" value="&lt;b&gt;3 · Cache&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;one answer per league, viewer and sync, until the next sync&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="flows-1">
          <mxGeometry x="740" y="290" width="200" height="104" as="geometry" />
        </mxCell>
        <mxCell id="flows-page-2-e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="flows-1" source="flows-page-1" target="flows-page-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flows-page-3" value="&lt;b&gt;4 · api/insights.py&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;builds the answer from the database, private bids only for their owner&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="flows-1">
          <mxGeometry x="990" y="290" width="200" height="104" as="geometry" />
        </mxCell>
        <mxCell id="flows-page-3-e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="flows-1" source="flows-page-2" target="flows-page-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flows-page-4" value="&lt;b&gt;5 · api/app.py&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;gzip and an ETag: 304 Not Modified when nothing changed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="flows-1">
          <mxGeometry x="1240" y="290" width="200" height="104" as="geometry" />
        </mxCell>
        <mxCell id="flows-page-4-e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="flows-1" source="flows-page-3" target="flows-page-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flows-page-back" value="JSON back to the page" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="flows-1" source="flows-page-4" target="flows-page-0">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1340.0" y="434" />
              <mxPoint x="340.0" y="434" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="flows-sync" value="&lt;b&gt;A sync&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;on the schedule, or started on the Status page&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="flows-1">
          <mxGeometry x="40" y="530" width="170" height="104" as="geometry" />
        </mxCell>
        <mxCell id="flows-sync-0" value="&lt;b&gt;1 · sync/scheduler.py&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;cron, by default at 02:10, 06:10, … 22:10&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="flows-1">
          <mxGeometry x="240" y="530" width="200" height="104" as="geometry" />
        </mxCell>
        <mxCell id="flows-sync-1" value="&lt;b&gt;2 · Fetch in parallel&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;table, matchdays, overview, market, squads, rankings, battles, activity feed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="flows-1">
          <mxGeometry x="490" y="530" width="200" height="104" as="geometry" />
        </mxCell>
        <mxCell id="flows-sync-1-e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="flows-1" source="flows-sync-0" target="flows-sync-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flows-sync-2" value="&lt;b&gt;3 · Only what is stale&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;player details every 12 h, value histories once a day, the feed until a known entry&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="flows-1">
          <mxGeometry x="740" y="530" width="200" height="104" as="geometry" />
        </mxCell>
        <mxCell id="flows-sync-2-e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="flows-1" source="flows-sync-1" target="flows-sync-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flows-sync-3" value="&lt;b&gt;4 · Pictures&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;the player's own photo › the CDN's picture pool › the club's placeholder&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="flows-1">
          <mxGeometry x="990" y="530" width="200" height="104" as="geometry" />
        </mxCell>
        <mxCell id="flows-sync-3-e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="flows-1" source="flows-sync-2" target="flows-sync-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flows-sync-4" value="&lt;b&gt;5 · Store&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;one transaction; core/analytics.py works out profits and balances&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="flows-1">
